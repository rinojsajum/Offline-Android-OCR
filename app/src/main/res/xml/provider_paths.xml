<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- This is your existing path. It's needed for viewing saved results. -->
    <external-path
        name="ocr_public_results_folder"
        path="Documents/OCR_Results/" />

    <!-- NEW: This path is needed to allow FileProvider to access files
         created by createImageFile() in getExternalFilesDir(Environment.DIRECTORY_PICTURES).
         The 'path="."' grants access to the root of your app's external files directory,
         which includes subdirectories like 'Pictures'. -->
    <external-files-path
        name="my_images"
        path="." />

    <!-- Your existing cache path, if still needed for other purposes -->
    <cache-path
        name="external_cache"
        path="." />

</paths>