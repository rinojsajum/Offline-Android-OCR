<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SavedResultsActivity">

    <!-- Optional Toolbar (if you choose to uncomment it in Java) -->
    <!--
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="?attr/homeAsUpIndicator"
        android:elevation="4dp"
        android:theme="?attr/actionBarTheme" />
    -->

    <!-- Header for Recent Files List - UPDATED TEXT (comment moved) -->
    <TextView
        android:id="@+id/tv_recent_files_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recent Files:"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:textStyle="bold"
        android:textAppearance="?attr/textAppearanceSubtitle1"
        android:visibility="visible" />

    <!-- Text view to show messages for the recent files list (e.g., "No files") -->
    <TextView
        android:id="@+id/tv_no_saved_files"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="No recent OCR files saved in the last week."
        android:visibility="visible"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <!-- RecyclerView for displaying recent files - now takes remaining height -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_saved_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone" />

    <!-- Button to open SAF file picker - MOVED TO THE END -->
    <Button
        android:id="@+id/btn_open_file_picker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="Open File From Storage"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:drawableStart="@android:drawable/ic_menu_agenda"
        android:drawablePadding="8dp"
        android:backgroundTint="@color/design_default_color_primary"
        android:textColor="@android:color/white"
        app:cornerRadius="8dp" />

</LinearLayout>
